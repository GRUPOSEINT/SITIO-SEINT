---
import Base from '../layouts/Base.astro';
import Button from './Button.astro';
import Card from './Card.astro';
import Roles from './Roles.astro';
import { LINKS, cotizarHref } from '../data/sitio';
import type { Rol } from '../data/roles';

interface Props {
  seo: { title: string; description: string };
  overline: string;
  titulo: string;
  intro: string;
  cruce: { href: string; label: string; boton?: boolean };
  rolesTitulo: string;
  roles: Rol[];
  cta: string;
  tema: 'Alturas' | 'Espacios confinados';
  independiente: string;
}
const p = Astro.props;
---
<Base title={p.seo.title} description={p.seo.description}>
<main class="theme-formacion">
  <section class="fhero px">
    <div class="container">
      <a href="/" class="back">← Inicio</a>
      <div class="overline" style="color:var(--teal-200);margin-top:20px"><span>{p.overline}</span></div>
      <h1 class="display fhero-h1">{p.titulo}</h1>
      <p class="fhero-p">{p.intro}</p>
      <div class="grid-auto" style="--min:220px;gap:16px;margin-top:32px">
        <div class="cred">
          <div class="cred-k">Ministerio del Trabajo</div>
          <div class="cred-v"><a href={LINKS.mintrabajo} target="_blank" rel="noopener">Aprobación Ministerio</a></div>
          <div style="font-size:14px;margin-top:4px;color:#fff">Búscanos como SEINT.</div>
        </div>
        <div class="cred"><div class="cred-k">ICONTEC</div><div class="cred-v">NTC 6072</div></div>
        <div class="cred"><div class="cred-k">Licencia SSO</div><div class="cred-v">No. 10728</div></div>
      </div>
      <p style="font-size:14px;color:var(--teal-200);margin:16px 0 0">El aval es de SEINT como centro aprobado y cubre todos los roles de esta página.</p>
      <div style="margin-top:24px">
        {p.cruce.boton
          ? <Button variant="inverse" href={p.cruce.href}>{p.cruce.label}</Button>
          : <a href={p.cruce.href} class="cruce">{p.cruce.label}</a>}
      </div>
    </div>
  </section>

  <section class="px" style="padding-top:clamp(32px,4vw,64px);padding-bottom:clamp(32px,4vw,64px)">
    <div class="container">
      <Roles titulo={p.rolesTitulo} roles={p.roles} cta={p.cta} />

      <div class="grid-auto" style="--min:280px;gap:20px;margin-top:clamp(32px,4vw,56px)">
        <Card surface="soft" padding="24px">
          <h3 class="h3" style="margin:0 0 8px">Fechas disponibles</h3>
          <p style="margin:0;font-size:15px">No publicamos calendario. Consulta los grupos abiertos de esta semana por formulario o WhatsApp y te confirmamos cupos en el mismo día.</p>
          <div style="margin-top:16px"><Button variant="outline" size="sm" href={cotizarHref(`${p.tema} — Consulta de fechas`)}>Consultar fechas</Button></div>
        </Card>
        <Card surface="navy" padding="24px">
          <h3 class="h3" style="margin:0 0 8px;color:#fff">¿Trabajas de forma independiente?</h3>
          <p style="margin:0;font-size:15px;color:#fff">También certificamos a personas por su cuenta, sin empresa que las respalde. El formulario es distinto: no te pedimos NIT ni número de trabajadores.</p>
          <div style="margin-top:16px"><Button variant="inverse" size="sm" href={cotizarHref(p.independiente, 'persona')}>Soy independiente</Button></div>
        </Card>
      </div>
      <slot />
    </div>
  </section>
</main>
</Base>
<style>
  .fhero { background: var(--surface-navy); color: #fff; padding-top: clamp(36px,5vw,72px); padding-bottom: clamp(36px,5vw,72px); }
  .back { color: var(--teal-300); font-size: 14px; }
  .back:hover { color: #fff; }
  .fhero-h1 { color: #fff; font-size: clamp(30px,5vw,54px); line-height: 1.06; margin: 24px 0 0; max-width: 24ch; letter-spacing: 0; }
  .fhero-p { font-size: clamp(16px,2vw,20px); line-height: 1.6; max-width: 56ch; margin: 20px 0 0; color: #fff; }
  .cred { border: 1px solid rgba(255,255,255,.22); border-radius: var(--radius-md); padding: 16px; }
  .cred-k { font-size: 11px; text-transform: uppercase; letter-spacing: .16em; color: var(--teal-200); }
  .cred-v { font-weight: 700; font-size: 18px; margin-top: 6px; }
  .cred-v a { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
  .cruce { display: inline-flex; align-items: center; justify-content: center; text-align: center; white-space: nowrap; min-height: 44px; max-width: 100%; padding: 8px clamp(12px,4vw,24px); border-radius: 999px; font-weight: 600; font-size: clamp(12px,3.9vw,16px); text-decoration: none; background: #fff; color: var(--navy-500); border: 2px solid #fff; transition: var(--transition-control); }
  .cruce:hover { background: var(--surface-brand-soft); color: var(--navy-500); text-decoration: none; }
</style>
