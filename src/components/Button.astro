---
// Botón píldora del sistema de diseño. Con `href` se pinta como enlace.
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'inverse';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}
const { variant = 'primary', size = 'md', href, type = 'button', class: cls, ...rest } = Astro.props;
const classes = ['btn', `btn--${variant}`, size !== 'md' && `btn--${size}`, cls];
---
{href
  ? <a href={href} class:list={classes} {...rest}><slot /></a>
  : <button type={type} class:list={classes} {...rest}><slot /></button>}
