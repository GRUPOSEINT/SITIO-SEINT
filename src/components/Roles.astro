---
// Roles desplegables. El texto vive en el HTML aunque el bloque esté cerrado (Google lo lee),
// cada rol se puede enlazar con #id y el botón despliega o cierra todos.
import Button from './Button.astro';
import { cotizarHref } from '../data/sitio';
import type { Rol } from '../data/roles';
interface Props { titulo: string; roles: Rol[]; cta: string }
const { titulo, roles, cta } = Astro.props;
---
<div class="roles-head">
  <h2 class="display roles-h2">{titulo}</h2>
  <button type="button" class="roles-all" data-roles-all>Desplegar todos los roles</button>
</div>
<div class="roles" data-roles>
  {roles.map((r, i) => (
    <details id={r.id} class="rol">
      <summary>
        <span class="rol-n">{String(i + 1).padStart(2, '0')}</span>
        <span style="flex:1">
          <span class="rol-name">{r.nombre}</span>
          <span class="rol-meta">{r.meta}</span>
        </span>
        <span class="hide-mobile rol-ver">Ver detalle</span>
      </summary>
      <div class="rol-body grid-auto" style="--min:240px">
        <div>
          <div class="label">Requisitos de ingreso</div>
          <ul>{r.requisitos.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div>
          <div class="label">Contenido temático</div>
          <ul>{r.temario.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div>
          <div class="label">Para quién es</div>
          <p>{r.paraQuien}</p>
          <div style="margin-top:20px"><Button href={cotizarHref(r.servicio)}>{cta}</Button></div>
        </div>
      </div>
    </details>
  ))}
</div>

<script>
  const all = document.querySelector<HTMLButtonElement>('[data-roles-all]');
  const items = () => Array.from(document.querySelectorAll<HTMLDetailsElement>('details.rol'));
  let open = false;
  const label = () => { if (all) all.textContent = open ? 'Cerrar todos los roles' : 'Desplegar todos los roles'; };
  all?.addEventListener('click', () => { open = !open; items().forEach((d) => (d.open = open)); label(); });
  // Enlace directo a un rol (#rol-…): abre ese bloque y lo lleva a la vista.
  const abrirHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id.startsWith('rol-')) return;
    const d = document.getElementById(id) as HTMLDetailsElement | null;
    if (d) { d.open = true; d.scrollIntoView({ block: 'start' }); }
  };
  abrirHash();
  window.addEventListener('hashchange', abrirHash);
  // Antes de imprimir se abren todos, para llevar la página completa al comité de compras.
  window.addEventListener('beforeprint', () => items().forEach((d) => (d.open = true)));
</script>

<style>
  .roles-head { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between; margin: clamp(28px,4vw,48px) 0 20px; }
  .roles-h2 { font-size: clamp(24px,3vw,32px); margin: 0; letter-spacing: 0; }
  .roles-all { height: 40px; padding: 0 20px; border-radius: 999px; border: 2px solid var(--navy-500); background: #fff; color: var(--navy-500); font-family: var(--font-core); font-weight: 600; font-size: 15px; cursor: pointer; transition: var(--transition-control); }
  .roles-all:hover { background: var(--navy-500); color: #fff; }
  .roles { display: flex; flex-direction: column; gap: 12px; }
  .rol { border: 1px solid var(--border-subtle); border-top: 3px solid var(--rule-color); border-radius: var(--radius-md); background: #fff; box-shadow: var(--shadow-sm); scroll-margin-top: 110px; }
  .rol summary { display: flex; gap: clamp(12px,3vw,16px); align-items: center; padding: clamp(16px,3vw,20px) clamp(16px,3vw,24px); min-height: 44px; }
  .rol-n { font-family: var(--font-display); font-weight: 800; font-size: 22px; color: var(--navy-200, #7A80B8); min-width: 38px; }
  .rol-name { display: block; font-family: var(--font-display); font-weight: 700; font-size: clamp(18px,2.2vw,22px); color: var(--navy-500); line-height: 1.3; }
  .rol-meta { display: block; font-size: 14px; color: var(--text-muted); margin-top: 2px; }
  .rol-ver { color: var(--text-accent); font-weight: 600; font-size: 14px; }
  .rol-body { padding: 0 clamp(16px,3vw,24px) 24px; gap: 24px; }
  .rol-body ul { margin: 10px 0 0; padding-left: 18px; font-size: 15px; line-height: 1.6; }
  .rol-body p { margin: 10px 0 0; font-size: 15px; line-height: 1.6; }
  @media print { .rol { break-inside: avoid; } .roles-all { display: none; } }
</style>
