---
// Foto del sitio. `foto` es el nombre base en public/fotos/ (existen -800 y -1600 en .webp y .jpg).
// Mientras SEINT no entregue una foto se muestra un recuadro con la descripción de la que va ahí.
// `src` admite una ruta directa (fotos del blog subidas desde /admin).
// Fotos frías y clínicas; el texto nunca va sobre la foto.
interface Props {
  foto?: string;
  src?: string;
  alt?: string;
  placeholder: string;
  position?: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
  style?: string;
}
const { foto, src, alt = '', placeholder, position = 'center', eager = false, sizes = '(min-width: 760px) 50vw, 100vw', class: cls, style } = Astro.props;
const base = foto ? `/fotos/${foto}` : null;
const loading = eager ? 'eager' : 'lazy';
---
<div class:list={['photo', cls]} style={style}>
  {base ? (
    <picture>
      <source type="image/webp" srcset={`${base}-800.webp 800w, ${base}-1600.webp 1600w`} sizes={sizes} />
      <img src={`${base}-1600.jpg`} srcset={`${base}-800.jpg 800w, ${base}-1600.jpg 1600w`} sizes={sizes} alt={alt} width="1600" height="1068" loading={loading} decoding="async" fetchpriority={eager ? 'high' : undefined} style={`object-position:${position}`} />
    </picture>
  ) : src ? (
    <img src={src} alt={alt} loading={loading} decoding="async" style={`object-position:${position}`} />
  ) : (
    <div class="photo-empty" role="img" aria-label={placeholder}><span>{placeholder}</span></div>
  )}
</div>
<style>
  .photo { position: relative; overflow: hidden; border-radius: var(--radius-lg); }
  .photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .photo-empty { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; text-align: center; padding: 12px; background: rgba(127,127,127,.08); font-size: 13px; line-height: 1.4; }
  .photo-empty::after { content: ''; position: absolute; inset: 0; border: 1.5px dashed currentColor; opacity: .35; border-radius: inherit; pointer-events: none; }
  .photo-empty span { opacity: .75; max-width: 28ch; }
</style>
