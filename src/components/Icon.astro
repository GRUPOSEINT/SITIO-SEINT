---
// Lucide 0.462 con trazo de 2 px, en línea en el HTML (sustituto del set propio de SEINT).
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props { name: string; size?: number; class?: string; style?: string }
const { name, size = 20, class: cls, style } = Astro.props;
const raw = readFileSync(join(process.cwd(), 'node_modules/lucide-static/icons', `${name}.svg`), 'utf8');
const inner = raw.replace(/<!--[\s\S]*?-->/, '').replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---
<svg class:list={['icon', cls]} style={style} xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={inner} />
<style>.icon { display: inline-block; flex: 0 0 auto; vertical-align: middle; }</style>
