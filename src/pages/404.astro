---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada · Grupo Empresarial SEINT" description="La página que buscas no existe o cambió de dirección." noindex>
<main class="px" style="padding-top:clamp(40px,6vw,88px);padding-bottom:clamp(40px,6vw,88px)">
  <div style="max-width:680px;margin:0 auto">
    <h1 class="display" style="font-size:clamp(26px,3.4vw,36px);margin:0 0 12px;letter-spacing:0">Esta página cambió de lugar</h1>
    <p style="margin:0;font-size:17px;line-height:1.6">Renovamos el sitio y algunas direcciones cambiaron. Esto es lo que más buscan:</p>
    <ul style="margin:20px 0 0;padding-left:20px;font-size:17px;line-height:1.9">
      <li><a href="/trabajo-en-alturas">Trabajo en alturas</a></li>
      <li><a href="/espacios-confinados">Espacios confinados</a></li>
      <li><a href="/medicina-ocupacional">Medicina ocupacional</a></li>
      <li><a href="/cotizar">Pedir cotización</a></li>
      <li><a href="/pagos">Pagos Bre-B</a></li>
    </ul>
    <div style="margin-top:28px"><a href="/" class="btn btn--outline">Volver al inicio</a></div>
  </div>
</main>
</Base>
