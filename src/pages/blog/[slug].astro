---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Button from '../../components/Button.astro';
import { render } from 'astro:content';
import { publicados, slugDe, temaDe, fechaCorta, type Post } from '../../data/blog';
import { SITIO, cotizarHref } from '../../data/sitio';

export async function getStaticPaths() {
  const posts = await publicados();
  return posts.map((post) => ({ params: { slug: slugDe(post) }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const d = post.data;
const url = new URL(`/blog/${slugDe(post)}`, Astro.site).toString();
const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.titulo,
  description: d.resumen,
  datePublished: d.fecha.toISOString(),
  image: d.foto ? [new URL(d.foto, Astro.site).toString()] : undefined,
  mainEntityOfPage: url,
  articleSection: d.categoria,
  inLanguage: 'es-CO',
  author: { '@type': 'Organization', name: SITIO.nombre, url: SITIO.url },
  publisher: { '@type': 'Organization', name: SITIO.nombre, logo: { '@type': 'ImageObject', url: new URL('/assets/logo-grupo-seint-degradado.png', Astro.site).toString() } },
};
---
<Base title={`${d.titulo} · Blog SEINT`} description={d.resumen} image={d.foto || undefined} type="article" noindex={d.borrador} jsonLd={article}>
<main class="px" style="padding-top:clamp(40px,6vw,80px);padding-bottom:clamp(40px,6vw,80px)">
  <article class={temaDe(post)} style="max-width:720px;margin:0 auto">
    <a href="/blog" style="font-weight:600;font-size:15px;color:var(--text-accent)">← Volver al blog</a>
    <div class="label" style="margin-top:24px">{d.categoria} · <time datetime={d.fecha.toISOString().slice(0, 10)}>{fechaCorta(d.fecha)}</time></div>
    <h1 class="display" style="font-size:clamp(28px,4vw,42px);line-height:1.08;margin:12px 0 20px;text-wrap:pretty">{d.titulo}</h1>
    <Photo src={d.foto || undefined} alt={d.titulo} placeholder="Foto del artículo" style="aspect-ratio:16/9;background:var(--surface-brand-soft)" />
    <div class="cuerpo"><Content /></div>
    <div class="cta-box">
      <span style="font-weight:700;color:var(--navy-500);font-size:17px">¿Necesitas este servicio para tu empresa?</span>
      <Button href={cotizarHref(d.servicio)}>Cotiza en 4 h</Button>
    </div>
  </article>
</main>
</Base>
<style>
  .cuerpo :global(p), .cuerpo :global(ul), .cuerpo :global(ol) { margin: 20px 0 0; font-size: 17px; line-height: 1.7; text-wrap: pretty; }
  .cuerpo :global(h2), .cuerpo :global(h3) { font-family: var(--font-display); color: var(--navy-500); line-height: 1.2; margin: 36px 0 0; }
  .cuerpo :global(h2) { font-size: 24px; font-weight: 800; }
  .cuerpo :global(h3) { font-size: 20px; font-weight: 700; }
  .cuerpo :global(img) { border-radius: var(--radius-md); margin-top: 20px; }
  .cuerpo :global(blockquote) { margin: 20px 0 0; padding: 4px 0 4px 20px; border-left: 3px solid var(--rule-color); }
  .cta-box { margin-top: 36px; padding: 24px; border-radius: var(--radius-lg); background: var(--surface-brand-soft); display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between; }
</style>
