---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import { publicados, slugDe, temaDe, fechaCorta } from '../../data/blog';
const posts = await publicados();
const cats = ['Todos', 'Formación', 'Salud ocupacional'];
---
<Base title="Blog SEINT · Normativa SST y salud ocupacional, explicada" description="Guías cortas para talento humano y responsables de SST: qué pide la norma, qué examen o curso corresponde y cómo evitar errores comunes.">
<main class="px" style="padding-top:clamp(40px,6vw,80px);padding-bottom:clamp(40px,6vw,80px)">
  <div class="container">
    <div class="blog-ov">Blog SEINT</div>
    <h1 class="display" style="font-size:clamp(30px,4.4vw,48px);line-height:1.06;margin:16px 0 12px;max-width:22ch">Normativa SST y salud ocupacional, explicada.</h1>
    <p style="margin:0;font-size:17px;line-height:1.6;max-width:60ch;text-wrap:pretty">Guías cortas para talento humano y responsables de SST: qué pide la norma, qué examen o curso corresponde y cómo evitar errores comunes.</p>
    <div class="filtros" role="group" aria-label="Filtrar por categoría">
      {cats.map((c, i) => <button type="button" data-cat={c} aria-pressed={i === 0 ? 'true' : 'false'}>{c}</button>)}
    </div>
    {posts.length === 0 && <p style="margin-top:32px;font-size:17px">Muy pronto publicaremos los primeros artículos.</p>}
    <div class="posts">
      {posts.map((p) => (
        <a href={`/blog/${slugDe(p)}`} class:list={['post', temaDe(p)]} data-post-cat={p.data.categoria}>
          <Photo src={p.data.foto || undefined} alt="" sizes="(min-width: 760px) 33vw, 100vw" placeholder="Foto del artículo" class="post-foto" style="border-radius:0" />
          <div class="post-body">
            <div class="label">{p.data.categoria} · {fechaCorta(p.data.fecha)}{p.data.borrador && ' · Borrador'}</div>
            <h2 class="post-h">{p.data.titulo}</h2>
            <p style="margin:0;font-size:15px;line-height:1.6;text-wrap:pretty">{p.data.resumen}</p>
            <span class="post-more">Leer artículo →</span>
          </div>
        </a>
      ))}
    </div>
    <p class="vacio" style="margin-top:32px;font-size:17px" hidden data-vacio>Aún no hay artículos en esta categoría.</p>
  </div>
</main>
</Base>
<script>
  const botones = document.querySelectorAll<HTMLButtonElement>('[data-cat]');
  const posts = document.querySelectorAll<HTMLElement>('[data-post-cat]');
  const vacio = document.querySelector<HTMLElement>('[data-vacio]')!;
  const filtrar = (cat: string) => {
    let n = 0;
    botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === cat)));
    posts.forEach((p) => { const ok = cat === 'Todos' || p.dataset.postCat === cat; p.hidden = !ok; if (ok) n++; });
    vacio.hidden = n > 0 || posts.length === 0;
  };
  botones.forEach((b) => b.addEventListener('click', () => filtrar(b.dataset.cat!)));
</script>
<style>
  .blog-ov { display: inline-block; font-size: 12px; text-transform: uppercase; letter-spacing: .18em; font-weight: 700; color: var(--teal-700); padding-bottom: 6px; border-bottom: 2px solid var(--teal-400); }
  .filtros { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; }
  .filtros button { min-height: 40px; padding: 8px 16px; border-radius: 999px; border: 1px solid var(--border-subtle); background: #fff; color: var(--navy-500); font: inherit; font-weight: 600; font-size: 14px; cursor: pointer; transition: var(--transition-control); }
  .filtros button[aria-pressed="true"] { background: var(--navy-500); color: #fff; border-color: var(--navy-500); }
  .posts { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(300px,100%),1fr)); gap: 24px; margin-top: 32px; }
  .post { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm); color: inherit; text-decoration: none; transition: var(--transition-control); }
  .post[hidden] { display: none; }
  .post:hover { color: inherit; text-decoration: none; box-shadow: var(--shadow-lg); }
  .post :global(.post-foto) { aspect-ratio: 16/9; background: var(--surface-brand-soft); }
  .post-body { padding: 20px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .post-h { font-family: var(--font-display); font-weight: 700; font-size: 20px; line-height: 1.25; color: var(--navy-500); margin: 0; text-wrap: pretty; }
  .post-more { margin-top: auto; padding-top: 8px; font-weight: 700; font-size: 15px; color: var(--text-accent); }
</style>
