---
// Portal de Biofile para empresas de la IPS. Se abre en pestaña nueva desde "Ingreso empresas IPS".
// El iframe es el plugin de Biofile sin modificar (confirmar con Biofile el código vigente).
import '../styles/global.css';
import { LINKS } from '../data/sitio';
---
<!doctype html>
<html lang="es-CO">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Ingreso empresas IPS · Grupo Empresarial SEINT</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/png" href="/assets/isotipo-1.png" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Exo:wght@400;600;700;800&display=swap" />
</head>
<body style="color:#1E2433">
  <header style="border-bottom:1px solid #E6E8EF;padding:14px clamp(20px,5vw,32px)">
    <div style="max-width:1200px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap">
      <a href="/"><img src="/assets/logo-grupo-seint-degradado.png" alt="Grupo Empresarial SEINT" style="height:40px;display:block" /></a>
      <span style="font-size:12px;text-transform:uppercase;letter-spacing:.18em;font-weight:700;color:#007A73">IPS · Ingreso empresas</span>
    </div>
  </header>
  <main style="max-width:1200px;margin:0 auto;padding:24px clamp(20px,5vw,32px)">
    <iframe width="100%" height="1200px" scrolling="auto" src={LINKS.biofile} frameborder="0" title="Portal de acceso a empresas"></iframe>
  </main>
</body>
</html>
