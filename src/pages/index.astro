---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import StatBlock from '../components/StatBlock.astro';
import Photo from '../components/Photo.astro';
import { LINKS, cotizarHref, waHref } from '../data/sitio';
import contadores from '../data/contadores.json';

const cifra = (n: number) => n.toLocaleString('es-CO') + '+';
const cursos = [
  'Rescate vertical', 'Certificación de punto de anclaje', 'Riesgo eléctrico', 'Primeros auxilios',
  'Manejo de montacargas', 'Andamiaje', 'Administración del riesgo', 'Seguridad vial organizacional',
  'Seguridad y Salud en el Trabajo', 'Trabajo en caliente', 'Inspección de equipos y EPP', 'Ergonomía', 'Autocuidado', 'IPER',
];
---
<Base
  title="Grupo Empresarial SEINT · Formación en alturas y medicina ocupacional en Bogotá"
  description="Del examen médico al certificado, en un solo lugar. Formación en trabajo en alturas y espacios confinados, y medicina ocupacional con laboratorio clínico propio: resultados en 3 horas."
>
<main>
  <section class="theme-formacion hero px">
    <div class="container" style="margin-bottom:8px">
      <div class="hero-pill-row"><span class="hero-pill">Centro de formación · IPS · Laboratorio clínico propio</span></div>
    </div>
    <div class="container grid-auto hero-grid">
      <div>
        <h1 class="display hero-h1">Del examen médico<br /><span style="color:var(--teal-300)">al certificado, en un solo lugar.</span></h1>
        <p class="hero-sub">Formación en tareas de alto riesgo y medicina ocupacional con laboratorio clínico propio, en un solo proveedor avalado.</p>
      </div>
      <Photo class="hero-photo" foto="portada-rescate-alturas" alt="Práctica de rescate en alturas en la torre de entrenamiento de SEINT" placeholder="Foto: trabajador con arnés en operación real (horizontal)" position="55% 40%" eager />
    </div>
    <div class="container" style="margin-top:20px">
      <div class="hero-ctas">
        <Button variant="inverse" href={cotizarHref('Consulta general')}>Cotizar</Button>
        <a href={waHref()} target="_blank" rel="noopener" class="hero-wa"><Icon name="message-circle" size={16} /> WhatsApp</a>
        <a href="/medicina-ocupacional" class="hero-3h">Resultados de laboratorio en 3 horas</a>
      </div>
    </div>
  </section>

  <section class="stats px">
    <div class="container grid-auto" style="--min:230px;gap:24px 32px">
      <StatBlock value="17+" label="Años de bienestar" />
      <StatBlock value={cifra(contadores.trabajadores_certificados)} label="Trabajadores certificados" />
      <StatBlock value={cifra(contadores.pacientes_atendidos)} label="Pacientes atendidos" />
      <StatBlock value="3 horas" label="Resultados de laboratorio" />
    </div>
  </section>

  <section class="px" style="padding-top:clamp(40px,6vw,80px);padding-bottom:clamp(40px,6vw,80px)">
    <div class="container grid-auto" style="--min:320px;gap:clamp(24px,3vw,40px)">
      <Card class="theme-formacion" topRule elevation="md" padding="clamp(24px,3vw,40px)">
        <Icon name="hard-hat" size={32} style="color:var(--brand-primary)" />
        <div class="overline" style="margin-top:12px"><span>Centro de capacitación</span></div>
        <h2 class="display unit-h2">Formación y Certificación</h2>
        <p style="margin:0;font-size:17px;line-height:1.6">No dictamos un curso: somos el centro de capacitación completo, aprobado por el Ministerio del Trabajo.</p>
        <div class="grid-auto" style="--min:200px;gap:8px 20px;margin:24px 0 0">
          <a href="/trabajo-en-alturas" class="pill-link" style="justify-self:start">Trabajo en alturas <Icon name="arrow-right" size={14} /></a>
          <a href="/espacios-confinados" class="pill-link" style="justify-self:start">Espacios confinados <Icon name="arrow-right" size={14} /></a>
        </div>
        <ul class="grid-auto cursos" style="--min:200px">
          {cursos.map((c) => <li><a href={cotizarHref(`Formación — ${c}`)}>{c}</a></li>)}
        </ul>
        <div class="grid-auto" style="--min:300px;margin-top:24px;gap:12px">
          <a href="/trabajo-en-alturas" class="block-btn" style="border-color:var(--navy-500);background:var(--navy-500);color:#fff">Ver formación en alturas</a>
          <a href="/espacios-confinados" class="block-btn" style="border-color:var(--navy-500);background:#fff;color:var(--navy-500)">Ver formación en espacios confinados</a>
        </div>
      </Card>

      <Card class="theme-salud" topRule elevation="md" padding="clamp(24px,3vw,40px)">
        <Icon name="stethoscope" size={32} style="color:var(--brand-primary)" />
        <div class="overline" style="margin-top:12px"><span>IPS habilitada</span></div>
        <h2 class="display unit-h2">Medicina Ocupacional</h2>
        <p style="margin:0;font-size:17px;line-height:1.6">Exámenes de ingreso, periódicos y de egreso, con el profesiograma definido por cargo y riesgo.</p>
        <div class="lab-box">
          <div class="lab-h">Laboratorio clínico propio</div>
          <div style="font-size:18px;font-weight:700;color:var(--navy-500);margin-top:8px">Resultados en 3 horas</div>
          <p style="font-size:14px;margin:12px 0 0;line-height:1.55">Aplica a los exámenes de laboratorio del perfil ocupacional básico, contadas desde la toma de la muestra, de lunes a sábado, con muestras tomadas entre 6:00 a.m. y 10:00 a.m. en sede Bogotá.</p>
        </div>
        <div style="margin-top:24px"><a href="/medicina-ocupacional" class="block-btn" style="background:var(--teal-400);color:var(--navy-500);border-color:var(--teal-400)">Ver medicina ocupacional</a></div>
      </Card>
    </div>
  </section>

  <section class="px" style="background:var(--surface-subtle);padding-top:clamp(32px,4vw,64px);padding-bottom:clamp(32px,4vw,64px)">
    <div class="container">
      <div class="overline" style="color:var(--teal-700)"><span>Aval oficial</span></div>
      <div class="grid-auto" style="--min:240px;gap:20px;margin-top:28px">
        <Card padding="20px">
          <div class="aval-k">Ministerio del Trabajo</div>
          <div class="aval-v"><a href={LINKS.mintrabajo} target="_blank" rel="noopener" style="color:var(--navy-500);text-decoration:underline;text-underline-offset:4px">Aprobación Ministerio</a></div>
          <div style="font-size:14px;margin-top:4px">Centro aprobado para formación en trabajo seguro en alturas.</div>
          <div style="font-size:14px;margin-top:4px;font-weight:600;color:var(--navy-500)">Búscanos como SEINT.</div>
        </Card>
        <Card padding="20px">
          <div class="aval-k">ICONTEC</div>
          <div class="aval-v">NTC 6072</div>
          <div style="font-size:14px;margin-top:4px">Certificación de organismos de formación en trabajo seguro en alturas.</div>
        </Card>
        <Card padding="20px">
          <div class="aval-k">Secretaría de Salud</div>
          <div class="aval-v">Licencia SSO No. 10728</div>
          <div style="font-size:14px;margin-top:4px">Licencia en Seguridad y Salud en el Trabajo.</div>
        </Card>
      </div>
    </div>
  </section>

  <section class="px" style="padding-top:clamp(32px,4vw,64px);padding-bottom:clamp(32px,4vw,64px)">
    <div class="container grid-auto" style="--min:280px;gap:20px">
      <Card surface="soft" padding="24px">
        <Icon name="file-check" size={24} style="color:var(--navy-500)" />
        <h3 class="h3" style="margin:12px 0 6px">Consultoría SST In-House</h3>
        <p style="margin:0;font-size:15px">Diseño e implementación del SG-SST, Copasst, CCL y sistemas de vigilancia epidemiológica.</p>
        <div style="margin-top:16px"><Button variant="outline" size="sm" href={cotizarHref('Consultoría SST In-House')}>Cotizar</Button></div>
      </Card>
      <Card surface="soft" padding="24px">
        <Icon name="shield-check" size={24} style="color:var(--navy-500)" />
        <h3 class="h3" style="margin:12px 0 6px">EPP y dotaciones</h3>
        <p style="margin:0;font-size:15px">Equipos de protección contra caídas y dotación por sector, con inspección de equipos.</p>
        <div style="margin-top:16px"><Button variant="outline" size="sm" href={cotizarHref('EPP y dotaciones')}>Cotizar</Button></div>
      </Card>
      <Card surface="navy" padding="24px">
        <h3 class="h3" style="margin:0 0 6px;color:#fff">¿No sabes qué examen o curso pedir?</h3>
        <p style="margin:0;font-size:15px;color:#fff">Revisamos la matriz de riesgo por cargo y te decimos qué falta y qué sobra.</p>
        <div style="margin-top:16px"><Button variant="inverse" size="sm" href={cotizarHref('Revisión de matriz por cargo')}>Pedir revisión</Button></div>
      </Card>
    </div>
  </section>
</main>
</Base>

<style>
  .hero { background: var(--surface-navy); color: #fff; padding-top: clamp(48px,7vw,96px); padding-bottom: clamp(48px,7vw,96px); }
  .hero-pill-row { display: flex; justify-content: flex-start; }
  .hero-pill { display: inline-flex; align-items: center; max-width: 100%; white-space: nowrap; padding: 7px clamp(10px,2.6vw,16px); border-radius: 999px; background: rgba(255,255,255,.16); color: #fff; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; font-size: clamp(9px,2.7vw,13px); line-height: 1; }
  .hero-grid { gap: clamp(32px,5vw,64px); align-items: stretch; }
  .hero-h1 { color: #fff; font-size: clamp(34px,5.4vw,60px); line-height: 1.04; margin: 20px 0 0; }
  .hero-sub { font-size: clamp(17px,2vw,20px); line-height: 1.6; max-width: 46ch; margin: 20px 0 0; color: #fff; }
  .hero :global(.hero-photo) { min-height: clamp(220px,60vw,300px); }
  .hero-ctas { display: flex; gap: 12px; align-items: center; justify-content: flex-start; flex-wrap: nowrap; }
  .hero-wa { display: inline-flex; align-items: center; gap: 6px; height: 44px; padding: 0 18px; border-radius: 999px; border: 2px solid rgba(255,255,255,.4); color: #fff; font-weight: 600; font-size: 15px; white-space: nowrap; }
  .hero-wa:hover { color: #fff; text-decoration: none; border-color: #fff; }
  .hero-3h { display: inline-flex; align-items: center; height: 44px; padding: 0 18px; border-radius: 999px; background: var(--teal-400); color: var(--navy-500); font-weight: 700; font-size: 15px; white-space: nowrap; max-width: 100%; text-decoration: none; }
  .hero-3h:hover { color: var(--navy-500); text-decoration: none; background: var(--teal-300); }
  @media (max-width: 759.98px) {
    .hero-pill-row, .hero-ctas { justify-content: center; }
    .hero-ctas { flex-wrap: wrap; }
  }
  .stats { background: var(--surface-subtle); border-bottom: 1px solid var(--border-subtle); padding-top: clamp(28px,4vw,48px); padding-bottom: clamp(28px,4vw,48px); }
  .unit-h2 { font-size: clamp(26px,3vw,34px); line-height: 1.1; margin: 24px 0 8px; letter-spacing: 0; }
  .cursos { list-style: none; padding: 0; margin: 20px 0 0; gap: 8px 20px; font-size: 15px; }
  .cursos a { color: inherit; }
  .cursos a:hover { color: var(--teal-700); text-decoration: underline; text-underline-offset: 3px; }
  .lab-box { margin-top: 24px; border-radius: var(--radius-md); background: var(--teal-50); padding: 20px; }
  .lab-h { font-family: var(--font-display); font-weight: 800; font-size: clamp(28px,3.4vw,40px); line-height: 1; color: var(--teal-700); }
  .aval-k { font-size: 12px; text-transform: uppercase; letter-spacing: .16em; color: var(--text-muted); font-weight: 700; }
  .aval-v { font-family: var(--font-display); font-weight: 700; font-size: 20px; color: var(--navy-500); margin-top: 8px; }
</style>
